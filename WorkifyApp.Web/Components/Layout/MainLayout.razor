@inherits LayoutComponentBase
@using Radzen
@using Radzen.Blazor

<div class="wf-layout">
    <!-- SIDEBAR -->
    <div class="wf-sidebar">
        <div class="wf-brand">
            <div class="logo-icon"></div>
            Workify MS
        </div>
        
        <NavMenu />
        
        <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
            <div class="wf-nav-item">
                <i class="material-icons">help_outline</i> Support
            </div>
            <div class="wf-nav-item">
               <i class="material-icons">account_circle</i> Profile
            </div>
        </div>
    </div>

    <!-- HEADER -->
    <div class="wf-header">
        <h3 style="margin:0; font-weight: 600;">My Workspace</h3>
        
        <div style="display: flex; gap: 1rem; align-items: center;">
            <input type="text" placeholder="Search..." style="background:var(--wf-bg); border:none; padding: 0.5rem 1rem; border-radius: 20px; outline:none;" />
            <button class="btn btn-primary" style="border-radius:50%; width: 40px; height: 40px; padding:0; display:flex; align-items:center; justify-content:center;">+</button>
        </div>
    </div>

    <!-- BODY -->
    <div class="wf-body">
        @Body
    </div>
</div>

<RadzenComponents />
